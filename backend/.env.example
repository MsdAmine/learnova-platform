JWT_SECRET=change-this-secret-later
JWT_EXPIRATION_MS=86400000

# Cloudinary media storage (see docs/decisions/0003-use-cloudinary-for-media-storage.md).
# Placeholders only — never commit real credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Demo accounts (seeded automatically on startup by DemoUserSeeder, all share the same password):
#   demo.learner@learnova.dev    - ROLE_LEARNER
#   demo.instructor@learnova.dev - ROLE_LEARNER + ROLE_INSTRUCTOR (pre-approved)
#   demo.admin@learnova.dev      - ROLE_LEARNER + ROLE_ADMIN
# Password for all three: Password123!